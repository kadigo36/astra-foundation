# Application
ASTRA_ENV=development
ASTRA_LOG_LEVEL=INFO
ASTRA_ALLOWED_ORIGINS=http://localhost:5173
ASTRA_DATABASE_URL=sqlite:///./astra.db

# Replace with a long, random secret outside local development
ASTRA_AUTH_SECRET=
ASTRA_ACCESS_TOKEN_MINUTES=30
ASTRA_ALLOW_PUBLIC_REGISTRATION=true

# Model provider — configure only in the backend environment
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Keep false on free tier unless you have reviewed Google's data-use terms
ASTRA_GEMINI_SHARE_MEMORY=false

# Database integrations — never expose service-role credentials to the browser
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — configure only on the backend; never commit real credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ASTRA_GOOGLE_TOKEN_ENCRYPTION_KEY=
ASTRA_FRONTEND_URL=http://localhost:5173

# WhatsApp integration is not active yet.

WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=

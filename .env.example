# Application
ASTRA_ENV=development
ASTRA_LOG_LEVEL=INFO
ASTRA_ALLOWED_ORIGINS=http://localhost:5173
ASTRA_DATABASE_URL=sqlite:///./astra.db

# Replace with a long, random secret outside local development
ASTRA_AUTH_SECRET=
ASTRA_ACCESS_TOKEN_MINUTES=30
ASTRA_ALLOW_PUBLIC_REGISTRATION=true

# Model provider — configure only in the backend environment
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Database integrations — never expose service-role credentials to the browser
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google/WhatsApp integrations are not active in v0.2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=

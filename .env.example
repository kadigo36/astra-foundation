# Application
ASTRA_ENV=development
ASTRA_LOG_LEVEL=INFO
ASTRA_ALLOWED_ORIGINS=http://localhost:5173

# Model provider — configure only in the backend environment
GEMINI_API_KEY=
GEMINI_MODEL=

# Database — never expose service-role credentials to the browser
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication (generate a strong random secret outside Git)
ASTRA_AUTH_SECRET=

# Integrations (disabled until explicitly configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
